# PostHog browser analytics (project token is public; never put a personal API key here)
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_ENABLED=true
# Local development is disabled by default; set true to send consented dev events.
VITE_POSTHOG_ENABLE_IN_DEVELOPMENT=false
